							name="check_title"
							type="list"
							label="PLG_SYSTEM_SEO_CHECKLIST_OPTIONS_CHECK_TITLE_LABEL"
							description="PLG_SYSTEM_SEO_CHECKLIST_OPTIONS_CHECK_TITLE_DESC"
							default="1"
					>
						<option value="0">JNO</option>
						<option value="1">JYES</option>
						<option value="2">PLG_SYSTEM_SEO_CHECKLIST_OPTIONS_JUST_SHOW</option>
					</field>

					<field
							name="check_description"
							type="list"
							label="PLG_SYSTEM_SEO_CHECKLIST_OPTIONS_CHECK_DESCRIPTION_LABEL"
